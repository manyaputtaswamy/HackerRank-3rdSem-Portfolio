#include <bits/stdc++.h>

using namespace std;

string ltrim(const string &);
string rtrim(const string &);
vector<string> split(const string &);

/*
 * Complete the 'diagonalDifference' function below.
 *
 * The function is expected to return an INTEGER.
 * The function accepts 2D_INTEGER_ARRAY arr as parameter.
 */

int diagonalDifference(vector<vector<int>> arr) {

    // Store the sum of the primary diagonal
    int primary = 0;

    // Store the sum of the secondary diagonal
    int secondary = 0;

    // Find both diagonal sums
    for (int i = 0; i < arr.size(); i++) {

        // Add elements from the primary diagonal
        primary += arr[i][i];

        // Add elements from the secondary diagonal
        secondary += arr[i][arr.size() - 1 - i];
    }

    // Return the absolute difference between the two sums
    return abs(primary - secondary);
}

int main()
{
    // Open the output file provided by HackerRank
    ofstream fout(getenv("OUTPUT_PATH"));

    // Read the size of the matrix
    string n_temp;
    getline(cin, n_temp);

    int n = stoi(ltrim(rtrim(n_temp)));

    // Create the square matrix
    vector<vector<int>> arr(n);

    // Read all elements of the matrix
    for (int i = 0; i < n; i++) {
        arr[i].resize(n);

        string arr_row_temp_temp;
        getline(cin, arr_row_temp_temp);

        // Split the input row into separate values
        vector<string> arr_row_temp = split(rtrim(arr_row_temp_temp));

        for (int j = 0; j < n; j++) {
            int arr_row_item = stoi(arr_row_temp[j]);

            arr[i][j] = arr_row_item;
        }
    }

    // Call the function to calculate the diagonal difference
    int result = diagonalDifference(arr);

    // Print the result
    fout << result << "\n";

    // Close the output file
    fout.close();

    return 0;
}

// Remove leading spaces from a string
string ltrim(const string &str) {
    string s(str);

    s.erase(
        s.begin(),
        find_if(s.begin(), s.end(), not1(ptr_fun<int, int>(isspace)))
    );

    return s;
}

// Remove trailing spaces from a string
string rtrim(const string &str) {
    string s(str);

    s.erase(
        find_if(s.rbegin(), s.rend(), not1(ptr_fun<int, int>(isspace))).base(),
        s.end()
    );

    return s;
}

// Split a string into separate values
vector<string> split(const string &str) {
    vector<string> tokens;

    string::size_type start = 0;
    string::size_type end = 0;

    // Find spaces and separate the values
    while ((end = str.find(" ", start)) != string::npos) {
        tokens.push_back(str.substr(start, end - start));

        start = end + 1;
    }

    // Add the last value
    tokens.push_back(str.substr(start));

    return tokens;
}
