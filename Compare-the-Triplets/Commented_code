/*
 * Complete the 'compareTriplets' function below.
 *
 * The function is expected to return an INTEGER_ARRAY.
 * The function accepts following parameters:
 *  1. INTEGER_ARRAY a
 *  2. INTEGER_ARRAY b
 */

vector<int> compareTriplets(vector<int> a, vector<int> b) {
    // Store the scores of Alice and Bob
    int alice = 0;
    int bob = 0;

    // Compare the three elements of Alice and Bob
    for (int i = 0; i < 3; i++) {

        // Alice gets one point if her score is greater
        if (a[i] > b[i])
            alice++;

        // Bob gets one point if his score is greater
        else if (a[i] < b[i])
            bob++;
    }

    // Return Alice's score followed by Bob's score
    return {alice, bob};
}

